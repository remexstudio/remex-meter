{
  "name": "remex-meter",
  "productName": "Remex Meter",
  "version": "0.62.0",
  "description": "Local-first macOS menu-bar meter for AI coding tool usage, cost and plan limits.",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "npm run ensure:tokscale && electron .",
    "hub": "node src/hub/server.js",
    "agent": "npm run ensure:tokscale && node src/agent/agent.js",
    "agent:once": "npm run ensure:tokscale && node src/agent/agent.js --once",
    "widget": "npm run ensure:tokscale && electron .",
    "dev": "npm run ensure:tokscale && electron .",
    "ensure:tokscale": "node scripts/ensure-vendored-tokscale.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:mac-widget": "node scripts/build-macos-widget.js",
    "dev:mac-widget": "node scripts/dev-macos-widget.js",
    "verify:mac:widget-app": "node scripts/verify-macos-widget-app.js",
    "sync:worker": "node scripts/sync-worker-shared.js",
    "update:hub-build": "node scripts/update-hub-build.js && npm run sync:worker",
    "pack": "npm run ensure:tokscale && electron-builder --config scripts/electron-builder.config.js --dir",
    "pack:mac:widget": "npm run ensure:tokscale -- --platform=darwin-arm64 && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_LOCAL_DEVELOPMENT_SIGNING=1 npm run build:mac-widget && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_LOCAL_DEVELOPMENT_SIGNING=1 node scripts/macos-packaging.js && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_LOCAL_DEVELOPMENT_SIGNING=1 electron-builder --config scripts/electron-builder.config.js --dir",
    "dist:mac": "npm run ensure:tokscale -- --platform=darwin-arm64 && electron-builder --config scripts/electron-builder.config.js --mac --arm64 --publish never",
    "dist:mac:widget": "npm run ensure:tokscale -- --platform=darwin-arm64 && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_WIDGET_DISTRIBUTION=1 TOKEN_MONITOR_WIDGET_ARCH=arm64 npm run build:mac-widget && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_WIDGET_DISTRIBUTION=1 TOKEN_MONITOR_WIDGET_ARCH=arm64 node scripts/macos-packaging.js && TOKEN_MONITOR_WIDGET_ENABLED=1 TOKEN_MONITOR_WIDGET_DISTRIBUTION=1 TOKEN_MONITOR_WIDGET_ARCH=arm64 electron-builder --config scripts/electron-builder.config.js --mac --arm64 --publish never",
    "verify:release-artifact-names": "node scripts/verify-updater-artifact-names.js dist",
    "benchmark:hub-bandwidth": "node scripts/benchmark-hub-bandwidth.js",
    "lint": "eslint .",
    "verify": "npm run lint && npm test"
  },
  "build": {
    "appId": "studio.remex.meter",
    "productName": "Remex Meter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/electron/**/*",
      "src/shared/**/*",
      "src/hub/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*",
      "node_modules/koffi/**/*"
    ],
    "mac": {
      "artifactName": "Remex-Meter-${version}-arm64.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "forceCodeSigning": true,
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "releaseInfo": {
      "releaseNotesFile": ".github/RELEASE_TEMPLATE.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "remexstudio",
        "repo": "remex-meter"
      }
    ]
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "cursor",
    "grok",
    "opencode",
    "deepseek",
    "token-usage",
    "cost-tracking",
    "ai-tools",
    "electron",
    "macos",
    "menu-bar",
    "local-first"
  ],
  "author": "Remex Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remexstudio/remex-meter.git"
  },
  "homepage": "https://github.com/remexstudio/remex-meter#readme",
  "bugs": {
    "url": "https://github.com/remexstudio/remex-meter/issues"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "koffi": "^3.1.5",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tokscale": "^4.17.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "electron": "43.4.0",
    "electron-builder": "26.16.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
